# Marketplace served by this instance. One server per country.
VIN_MARKETPLACE=it

# Session strategy. Pick one, or leave both empty to go direct.
# Cookies copied from a browser, "name=value; name=value".
VIN_COOKIE=
# FlareSolverr endpoint, reachable from this process.
VIN_FLARESOLVERR_URL=

# Requests per minute towards Vinted. Raising it is how you earn a challenge.
VIN_RATE_LIMIT_PER_MINUTE=6

# HTTP transport. Leave commented out for stdio.
#VIN_TRANSPORT=http
#VIN_HTTP_HOST=0.0.0.0
#VIN_HTTP_PORT=3000
#VIN_HTTP_ALLOWED_HOSTS=vinted-search-mcp.example.com
#VIN_MCP_TOKEN=
